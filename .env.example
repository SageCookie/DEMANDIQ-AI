APP_ENV=development
DATABASE_URL=sqlite:///./demandiq.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/demandiq
MODEL_PATH=models/production/demand_model.joblib
METADATA_PATH=models/production/metadata.json
DEFAULT_FORECAST_HORIZON=30
DEFAULT_SERVICE_LEVEL=0.95
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=replace_with_a_long_random_secret_in_production
# Used only to bootstrap an empty deployed database. Remove after first sign-in.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
